  "keyFeatures": [
    "Venue booking and management system",
    "Player match-making and matching requests",
    "Payment processing with Stripe integration",
    "Geospatial venue search with PostGIS",
    "Multi-role authentication (Player, Owner, Admin)",
    "Email notifications for bookings and matches",
    "Media management with Cloudinary",
    "Admin dashboard with analytics"
  ],
  "publicApiSurface": [
    "GET /api/venues - List active venues",
    "GET /api/venues/{id} - Get venue details",
    "GET /api/venues/nearby - Find venues near location",
    "POST /api/bookings - Create booking",
    "GET /api/bookings/my - Get my bookings",
    "PATCH /api/bookings/{id}/cancel - Cancel booking",
    "POST /api/match-requests - Create match request",
    "GET /api/match-requests/search - Search available match slots",
    "POST /api/match-requests/{id}/join - Join match request",
    "GET /api/me - Get current user profile",
    "POST /api/owner/venues - Create venue (owner)",
    "GET /api/owner/bookings - Get venue bookings (owner)",
    "POST /api/owner/resources - Create resource (owner)",
    "GET /api/admin/stats - Get platform statistics (admin)",
    "GET /api/admin/users - List users (admin)"
  ]
